{
  "name": "mesh-ecology-rbc",
  "version": "0.0.0",
  "description": "Deterministic Rulebook Cascade resolver for Mesh Ecology effective rule views.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./conformance": "./conformance/index.js"
  },
  "bin": {
    "rbc-proof": "./bin/rbc-proof.js"
  },
  "scripts": {
    "test": "node --test",
    "example": "node examples/basic-resolution.js",
    "proof:list": "node bin/rbc-proof.js list",
    "proof:run": "node bin/rbc-proof.js run",
    "rbc:layer-boundary-pressure": "node scripts/evaluate-layer-boundary-pressure-packet.mjs",
    "rbc:layer-boundary-review": "node scripts/evaluate-layer-boundary-review-packet.mjs",
    "rbc:edge-request-packet": "node scripts/evaluate-edge-request-packet.mjs",
    "rbc:file-resource-lift-operator-decision": "node scripts/evaluate-file-resource-lift-operator-decision.mjs",
    "rbc:file-resource-admission-candidate": "node scripts/evaluate-file-resource-admission-candidate.mjs",
    "rbc:file-resource-source-continuity-acceptance-admissibility": "node scripts/evaluate-file-resource-source-continuity-acceptance-admissibility.mjs",
    "release:check": "node scripts/release-check.js"
  },
  "keywords": [
    "mesh-ecology",
    "rbc",
    "rulebook-cascade"
  ],
  "license": "MIT"
}
